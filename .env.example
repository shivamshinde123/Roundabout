# Copy to .env.local and fill in. See Docs/environment-config-reference.md.
# Local values come from `npx supabase status` after `npx supabase start`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Hosted: transaction pooler on port 6543. Local: same as DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres
# Migrations only (drizzle-kit). Hosted: direct/session connection on port 5432.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres
